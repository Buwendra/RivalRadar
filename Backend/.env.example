# AWS (required for CDK deploy)
CDK_DEFAULT_ACCOUNT=          # aws sts get-caller-identity --query Account --output text
CDK_DEFAULT_REGION=us-east-1

# Frontend URL (required — canonical origin for email links; CORS fallback
# when ALLOWED_ORIGINS is unset or empty)
FRONTEND_URL=https://kironyx.com

# All origins allowed to call the API, comma-separated (optional — defaults
# to FRONTEND_URL alone). Set this when the app serves from several domains.
# Do NOT leave a blank value: give it origins or delete the line.
ALLOWED_ORIGINS=https://kironyx.com,https://www.kironyx.com,https://main.d1zrq9gf129s9u.amplifyapp.com

# SES sender email (must be verified in AWS SES console)
FROM_EMAIL=noreply@kironyx.com

# Paddle price IDs (from Paddle Dashboard > Catalog > Prices)
PADDLE_PRICE_SCOUT=pri_xxxxxxxxxxxxxxxxxxxx
PADDLE_PRICE_STRATEGIST=pri_xxxxxxxxxxxxxxxxxxxx
PADDLE_PRICE_COMMAND=pri_xxxxxxxxxxxxxxxxxxxx

# Stored in AWS Secrets Manager under "kironyx/api-keys" (JSON):
# {
#   "PADDLE_SECRET_KEY": "...",       # Paddle Dashboard > Developer > Authentication
#   "PADDLE_WEBHOOK_SECRET": "...",   # Paddle Dashboard > Developer > Notifications
#   "ANTHROPIC_API_KEY": "...",       # console.anthropic.com
#   "ELEVENLABS_API_KEY": "..."       # optional — weekly audio briefing (elevenlabs.io)
# }

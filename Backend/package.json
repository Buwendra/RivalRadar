{
  "name": "rivalscan-backend",
  "version": "1.0.0",
  "description": "RivalScan AWS Serverless Backend — CDK + Lambda (TypeScript)",
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all",
    "deploy:stack": "cdk deploy",
    "diff": "cdk diff",
    "destroy": "cdk destroy --all",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1063.0",
    "@aws-sdk/client-cloudwatch": "^3.1063.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1063.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1063.0",
    "@aws-sdk/client-dynamodb": "^3.1063.0",
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/client-secrets-manager": "^3.1063.0",
    "@aws-sdk/client-sesv2": "^3.1063.0",
    "@aws-sdk/client-sfn": "^3.1063.0",
    "@aws-sdk/client-sns": "^3.1063.0",
    "@aws-sdk/lib-dynamodb": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@paddle/paddle-node-sdk": "^3.8.0",
    "@types/pdfkit": "^0.17.6",
    "aws-cdk-lib": "^2.258.0",
    "constructs": "^10.6.0",
    "pdfkit": "^0.19.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^25.9.2",
    "aws-cdk": "^2.1126.0",
    "esbuild": "^0.28.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "ulid": "^3.0.2",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "license": "UNLICENSED",
  "private": true
}
